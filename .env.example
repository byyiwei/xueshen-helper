# MySQL 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xuexitong
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=xuexitong

# JWT 密钥（随机生成64字符，可用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成）
JWT_SECRET=your-jwt-secret-here

# 中控（openget Hub）应用密钥：邮件统一出口 /open/mail/send 与模型网关 /open/v1/chat/completions 都用它签名。
# 只存服务端环境变量；未设置时回用「系统配置→单点登录」里已存的 App Secret，两者都空则相关调用一律失败。
HUB_APP_SECRET=your-hub-app-secret-here
